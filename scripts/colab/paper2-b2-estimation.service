[Unit]
Description=Paper II B2 budget-capped estimation supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=PATH=/opt/oe-watchdog/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/paper2-b2-estimation.env
WorkingDirectory=/opt/paper2-b2/repo
ExecStart=/opt/oe-watchdog/bin/python -m experiments.openevolve.colab.paper2_b2_watchdog --live
Restart=on-failure
RestartSec=60
StartLimitIntervalSec=86400
StartLimitBurst=24
TimeoutStartSec=infinity
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/paper2-b2 /root/.config/colab-cli /root/.oe /tmp

[Install]
WantedBy=multi-user.target
